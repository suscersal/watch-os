# Основа взята из официального примера Waveshare 02_lvgl_demo_v9 (flash, PSRAM, LVGL).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# PSRAM: большие выделения (cJSON, ответы сети, буферы LVGL) идут в PSRAM,
# мелкие (до 4 КБ) остаются во внутренней памяти - она быстрее и нужна Wi-Fi/DMA.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Wi-Fi/lwIP: буферы в PSRAM и без IRAM-оптимизаций. В логе после запуска launcher оставалось
# "heap internal: free 115" и сыпалось "wifi:ioctl: failed to get wifi thread sem".
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6

# Буфер отрисовки: 20 строк x 2 (двойной, ~33 КБ во внутренней DMA-памяти). 40 строк x 2 не влезло:
# после запуска Wi-Fi внутренней памяти почти не остаётся (assert "Not enough memory for LVGL buffer (buf2)").
CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_HEIGHT=20

CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# Задача системных событий (sys_evt): по умолчанию стек 2304 Б, а в ней wifi.c при получении IP сохраняет сеть в settings.json
# (запись файла на LittleFS) - стек переполнялся и плата перезагружалась до сохранения пароля.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# HTTPS: набор корневых сертификатов (esp_crt_bundle)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# LVGL (Kconfig вместо lv_conf.h)
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=n
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_QRCODE=y

# Галерея: JPEG-декодер и кэш декодированных картинок (в PSRAM)
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
CONFIG_LV_CACHE_DEF_SIZE=4194304
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=64
