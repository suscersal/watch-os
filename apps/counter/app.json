{
  "start": "main",
  "vars": { "count": 0 },
  "screens": {
    "main": {
      "title": "Counter",
      "ui": [
        { "type": "label", "text": "@count", "size": "large" },
        { "type": "row", "children": [
          { "type": "button", "text": "-1", "color": "#EF4444", "on_click": [ { "do": "add", "var": "count", "value": -1 } ] },
          { "type": "button", "text": "+1", "on_click": [ { "do": "add", "var": "count", "value": 1 } ] }
        ] },
        { "type": "button", "text": "Reset", "color": "#6B7280",
          "on_click": [ { "do": "confirm", "title": "Reset?", "text": "Set the counter back to 0?",
                         "on_yes": [ { "do": "set", "var": "count", "value": 0 }, { "do": "toast", "text": "Reset" } ] } ] }
      ]
    }
  }
}
